{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./dist",
    "esModuleInterop": true,
    "isolatedModules": true,
    "noUnusedParameters": true,
    "noUnusedLocals": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "types": [ "vitest/globals"],
  },
  "include": [
    "src/**/*.ts",
    "eslint.config.ts",
    "server.ts",
    "__tests__/**/*.ts",
    "vitest.config.ts"
  ],
}